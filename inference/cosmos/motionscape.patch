+def _maybe_downscale_video_for_io(video: torch.Tensor) -> torch.Tensor:
+    """Pre-downscale oversized input videos before float conversion to cap host memory usage."""
+
+    orig_h, orig_w = video.shape[2], video.shape[3]
+    if orig_h <= _MAX_INPUT_VIDEO_HEIGHT and orig_w <= _MAX_INPUT_VIDEO_WIDTH:
+        return video
+
+    scaling_ratio = min(_MAX_INPUT_VIDEO_HEIGHT / orig_h, _MAX_INPUT_VIDEO_WIDTH / orig_w)
+    resized_h = max(1, int(math.floor(orig_h * scaling_ratio)))
+    resized_w = max(1, int(math.floor(orig_w * scaling_ratio)))
+    log.info(f"Downscaling input video from {orig_h}x{orig_w} to {resized_h}x{resized_w} before preprocessing")
+    return torchvision.transforms.functional.resize(video, [resized_h, resized_w], antialias=True)
+
