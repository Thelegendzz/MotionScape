+def _slice_video_frames(video_tensor: torch.Tensor, input_frame_start: int | None, input_frame_end: int | None) -> torch.Tensor:
+    """
+    Select a temporal segment from a video tensor in (C, T, H, W) format.
+
+    Args:
+        video_tensor: Input video tensor in (C, T, H, W) format.
+        input_frame_start: Inclusive start frame. Defaults to the start of the video.
+        input_frame_end: Exclusive end frame. Defaults to the end of the video.
+
+    Returns:
+        torch.Tensor: Sliced video tensor in (C, T, H, W) format.
+    """
+
+    available_frames = video_tensor.shape[1]
+    start_idx = 0 if input_frame_start is None else input_frame_start
+    end_idx = available_frames if input_frame_end is None else input_frame_end
+
+    if start_idx < 0:
+        raise ValueError(f"input_frame_start must be >= 0, but got {start_idx}")
+    if end_idx < 0:
+        raise ValueError(f"input_frame_end must be >= 0, but got {end_idx}")
+    if start_idx >= available_frames:
+        raise ValueError(
+            f"input_frame_start={start_idx} is out of range for a video with {available_frames} frames"
+        )
+    if end_idx > available_frames:
+        raise ValueError(f"input_frame_end={end_idx} exceeds the input video length of {available_frames} frames")
+    if end_idx <= start_idx:
+        raise ValueError(
+            f"Expected input_frame_end > input_frame_start, but got {input_frame_start=} and {input_frame_end=}"
+        )
+
+    sliced_video = video_tensor[:, start_idx:end_idx, :, :]
+    log.info(f"Selected input video segment [{start_idx}, {end_idx}) with {sliced_video.shape[1]} frames")
+    return sliced_video
+
